generator client {
  provider            = "prisma-client"
  output              = "../src/persistence/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum OfferKind {
  NEW
  USED
}

model Artist {
  id       String          @id @default(uuid()) @db.Uuid
  name     String          @unique @db.VarChar(200)
  editions EditionArtist[]
  tracks   TrackArtist[]
}

model Genre {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @unique @db.VarChar(200)
  editions        EditionGenre[]
  principalOf     Edition[]
  couponTargets   CouponTarget[]
}

model Label {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(200)
  editions Edition[]
}

model Edition {
  id                   String          @id @default(uuid()) @db.Uuid
  title                String          @db.VarChar(300)
  labelId              String?         @db.Uuid
  label                Label?          @relation(fields: [labelId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  primaryGenreId       String          @db.Uuid
  primaryGenre         Genre           @relation(fields: [primaryGenreId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  originalYear         Int?
  editionYear          Int?
  format               String          @db.VarChar(60)
  catalogNumber        String?         @db.VarChar(100)
  weightGrams          Int?
  pressingCountry      String?         @db.VarChar(100)
  collectorEdition     Boolean         @default(false)
  lowStockNewThreshold Int             @default(0)
  active               Boolean         @default(false)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)
  artists              EditionArtist[]
  genres               EditionGenre[]
  tracks               Track[]
  offers               Offer[]
  images               ProductImage[]
  wishes               WishlistEntry[]
  availabilityAlerts   AvailabilityAlert[]
  reviews              Review[]
  couponTargets        CouponTarget[]
  orderItems           OrderItem[]

  @@index([labelId])
  @@index([primaryGenreId])
  @@index([active, title, id])
  @@index([active, editionYear])
}

model EditionArtist {
  editionId String  @db.Uuid
  artistId  String  @db.Uuid
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([editionId, artistId])
  @@index([artistId])
}

model EditionGenre {
  editionId String  @db.Uuid
  genreId   String  @db.Uuid
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([editionId, genreId])
  @@index([genreId])
}

model Track {
  id              String        @id @default(uuid()) @db.Uuid
  editionId       String        @db.Uuid
  edition         Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  position        Int
  title           String        @db.VarChar(300)
  durationSeconds Int?
  audioUrl        String?       @db.VarChar(2048)
  artists         TrackArtist[]

  @@unique([editionId, position])
}

model TrackArtist {
  trackId  String @db.Uuid
  artistId String @db.Uuid
  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([trackId, artistId])
  @@index([artistId])
}

model ConditionGrade {
  code    String  @id @db.VarChar(3)
  label   String  @db.VarChar(100)
  rank    Int     @unique
  discs   Offer[] @relation("DiscGrade")
  sleeves Offer[] @relation("SleeveGrade")
}

model Offer {
  id           String          @id @default(uuid()) @db.Uuid
  editionId    String          @db.Uuid
  edition      Edition         @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind         OfferKind
  priceCents   Int
  discGrade    String?         @db.VarChar(3)
  sleeveGrade  String?         @db.VarChar(3)
  disc         ConditionGrade? @relation("DiscGrade", fields: [discGrade], references: [code], onDelete: Restrict, onUpdate: NoAction)
  sleeve       ConditionGrade? @relation("SleeveGrade", fields: [sleeveGrade], references: [code], onDelete: Restrict, onUpdate: NoAction)
  particulars  String?         @db.VarChar(4000)
  stockOnHand  Int             @default(0)
  active       Boolean         @default(false)
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  images       ProductImage[]
  movements    StockMovement[]
  exchangeOriginals ExchangeItem[] @relation("ExchangeOriginal")
  substitutes SubstituteOffer[]
  promotions   PromotionOffer[]
  couponTargets CouponTarget[]
  cartItems CartItem[]
  checkoutItems CheckoutItem[]
  reservations Reservation[]
  orderItems OrderItem[]
  currentUnits OrderUnit[]

  @@index([editionId, kind, active])
  @@index([active, priceCents])
  @@index([discGrade])
  @@index([sleeveGrade])
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  editionId   String?  @db.Uuid
  offerId     String?  @db.Uuid
  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offer       Offer?   @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  storageKey  String   @unique @db.VarChar(100)
  description String   @db.VarChar(500)
  position    Int
  contentHash String   @db.Char(64)
  mimeType    String   @db.VarChar(20)
  byteSize    Int
  width       Int
  height      Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([editionId, position])
  @@unique([offerId, position])
}

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  offerId       String   @db.Uuid
  offer         Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  deltaOnHand   Int
  offerVersion  Int
  balanceBefore Int
  balanceAfter  Int
  reason        String   @db.VarChar(500)
  originKey     String   @unique @db.VarChar(200)
  actorId       String?  @db.Uuid
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([offerId, createdAt, id])
  @@index([actorId])
  @@unique([offerId, offerVersion])
}

enum AccountContext {
  CUSTOMER
  STAFF
}

enum Role {
  USER
  ADMIN
  OPERATOR
}

enum EmailPurpose {
  VERIFY
  CHANGE
  REACTIVATE
}

enum MessageStatus {
  PENDING
  FAILED
  DELIVERED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  emailNormalized String          @unique
  passwordHash    String
  context         AccountContext
  role            Role
  emailVerifiedAt DateTime?       @db.Timestamptz(3)
  blockedAt       DateTime?       @db.Timestamptz(3)
  closedAt        DateTime?       @db.Timestamptz(3)
  inactiveAt      DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  resets          PasswordReset[]
  emailTokens     EmailToken[]
  auditLogs       AuditLog[]
  messages        DemoMessage[]
  addresses       Address[]
  stockMovements  StockMovement[]
  wishes          WishlistEntry[]
  availabilityAlerts AvailabilityAlert[]
  reviews         Review[]
  cart            Cart?
  checkouts       Checkout[]
  couponUsages    CouponUsage[]
  reviewRevisions ReviewRevision[]
  orders          Order[]
  cancellations   CancellationRequest[]
  returnEvidence  Evidence[]
  externalInteractions ExternalInteraction[]
  paymentAttempts PaymentAttempt[]
  refundAttempts RefundAttempt[]
  orderStatusEvents OrderStatusEvent[]
  originalShipmentRecords Shipment[]
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  credentialHash    String    @unique @db.Char(64)
  refreshHash       String    @unique @db.Char(64)
  usedRefreshHashes String[]  @default([])
  csrfHash          String    @db.Char(64)
  expiresAt         DateTime  @db.Timestamptz(3)
  refreshExpiresAt  DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model Address {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  recipient    String
  zip          String    @db.VarChar(8)
  region       String    @db.VarChar(2)
  city         String
  neighborhood String
  street       String
  number       String
  complement   String?
  deletedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  checkouts    Checkout[]

  @@index([userId, deletedAt])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model EmailToken {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose      EmailPurpose
  pendingEmail String?
  tokenHash    String       @unique @db.Char(64)
  expiresAt    DateTime     @db.Timestamptz(3)
  usedAt       DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose, expiresAt])
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  actorId         String?  @db.Uuid
  actor           User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action          String
  targetType      String
  targetId        String
  result          String
  reason          String
  redactedChanges Json
  correlationId   String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model DomainEvent {
  id            String        @id @default(uuid()) @db.Uuid
  type          String
  aggregateId   String
  payload       Json
  processedAt   DateTime?     @db.Timestamptz(3)
  attempts      Int           @default(0)
  lastErrorCode String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  messages      DemoMessage[]
  availabilityAlerts AvailabilityAlert[]

  @@index([processedAt, createdAt, id])
}

model DemoMessage {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventId        String?       @db.Uuid
  event          DomainEvent?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tokenRef       String?       @db.Uuid
  type           String
  restrictedBody String
  dedupKey       String        @unique
  status         MessageStatus @default(PENDING)
  deliveredAt    DateTime?     @db.Timestamptz(3)
  attempts       Int           @default(0)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  availabilityAlertId String? @unique @db.Uuid
  availabilityAlert AvailabilityAlert? @relation(fields: [availabilityAlertId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([eventId])
  @@index([status, createdAt])
}

enum AvailabilityKind {
  NEW
  USED
  ANY
}

enum AvailabilityStatus {
  ACTIVE
  DELIVERED
  CANCELLED
}

model WishlistEntry {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  editionId String @db.Uuid
  edition Edition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([userId, editionId])
  @@index([editionId])
  @@index([userId, createdAt, id])
}

model AvailabilityAlert {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  editionId String @db.Uuid
  edition Edition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  kind AvailabilityKind
  status AvailabilityStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  message DemoMessage?
  triggerEventId String? @db.Uuid
  triggerEvent DomainEvent? @relation(fields: [triggerEventId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt, id])
  @@index([editionId, status, kind, createdAt])
  @@index([triggerEventId])
}

enum ReviewVisibility {
  PUBLIC
  HIDDEN
}

enum DiscountType {
  PERCENT
  FIXED
}

model Promotion {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(200)
  type DiscountType
  amount Int
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  offers PromotionOffer[]
  @@index([active, startsAt, endsAt])
}

model PromotionOffer {
  promotionId String @db.Uuid
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  offerId String @db.Uuid
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  @@id([promotionId, offerId])
  @@index([offerId])
}

model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  type DiscountType
  amount Int
  minimumEligibleCents Int @default(0)
  allowPromotional Boolean @default(false)
  totalLimit Int?
  perUserLimit Int?
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  targets CouponTarget[]
  usages CouponUsage[]
  @@index([active, startsAt, endsAt])
}

model CouponTarget {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  offerId String? @db.Uuid
  offer Offer? @relation(fields: [offerId], references: [id], onDelete: Restrict)
  editionId String? @db.Uuid
  edition Edition? @relation(fields: [editionId], references: [id], onDelete: Restrict)
  genreId String? @db.Uuid
  genre Genre? @relation(fields: [genreId], references: [id], onDelete: Restrict)
  @@unique([couponId, offerId])
  @@unique([couponId, editionId])
  @@unique([couponId, genreId])
  @@index([offerId])
  @@index([editionId])
  @@index([genreId])
}

model Review {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  editionId String @db.Uuid
  edition Edition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  orderId String @db.Uuid
  rating Int
  comment String @db.VarChar(4000)
  visibility ReviewVisibility @default(PUBLIC)
  awaitingModeration Boolean @default(false)
  hiddenReason String? @db.VarChar(500)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  revisions ReviewRevision[]
  @@unique([userId, editionId, orderId])
  @@index([editionId, visibility, createdAt, id])
  @@index([userId, createdAt, id])
  @@index([orderId])
}

model ReviewRevision {
  id String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  version Int
  rating Int
  comment String @db.VarChar(4000)
  visibility ReviewVisibility
  awaitingModeration Boolean
  action String @db.VarChar(30)
  reason String @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([reviewId, version])
  @@index([actorId])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorScope  String   @db.VarChar(200)
  operation   String   @db.VarChar(100)
  key         String   @db.VarChar(128)
  requestHash String   @db.Char(64)
  resultRef   String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorScope, operation, key])
}

enum CheckoutStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  CONVERTED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum CouponUsageStatus {
  RESERVED
  CONSUMED
  RELEASED
}

model Cart {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items CartItem[]
  checkouts Checkout[]
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Restrict)
  offerId String @db.Uuid
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  quantity Int
  lastSeenPriceCents Int
  @@unique([cartId, offerId])
  @@index([offerId])
}

model Checkout {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  cartId String @db.Uuid
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Restrict)
  cartVersion Int
  status CheckoutStatus @default(ACTIVE)
  version Int @default(1)
  couponCode String? @db.VarChar(40)
  requestKey String @db.VarChar(128)
  requestHash String @db.Char(64)
  pricingRevision String @db.Char(64)
  quoteSnapshot Json
  addressId String? @db.Uuid
  address Address? @relation(fields: [addressId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  items CheckoutItem[]
  couponUsage CouponUsage?
  freightSnapshot Json?
  freightRevision String? @db.Char(64)
  order Order?
  paymentAttempts PaymentAttempt[]
  @@unique([userId, requestKey])
  @@index([userId, status, expiresAt])
  @@index([status, expiresAt, id])
  @@index([cartId])
  @@index([addressId])
}

model CheckoutItem {
  id String @id @default(uuid()) @db.Uuid
  checkoutId String @db.Uuid
  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  offerId String @db.Uuid
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  quantity Int
  snapshot Json
  reservation Reservation?
  @@unique([checkoutId, offerId])
  @@index([offerId])
}

model Reservation {
  id String @id @default(uuid()) @db.Uuid
  offerId String @db.Uuid
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  checkoutItemId String? @unique @db.Uuid
  checkoutItem CheckoutItem? @relation(fields: [checkoutItemId], references: [id], onDelete: Restrict)
  substituteId String? @unique @db.Uuid
  substitute SubstituteOffer? @relation(fields: [substituteId], references: [id], onDelete: Restrict)
  orderItemId String? @unique @db.Uuid
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity Int
  status ReservationStatus @default(ACTIVE)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)
  @@index([offerId, status, expiresAt])
  @@index([status, expiresAt, id])
}

model CouponUsage {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  checkoutId String @unique @db.Uuid
  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  status CouponUsageStatus @default(RESERVED)
  orderId String? @unique @db.Uuid
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)
  @@index([couponId, status, expiresAt])
  @@index([userId, couponId, status, expiresAt])
}

model FreightRate {
  id String @id @default(uuid()) @db.Uuid
  region String @db.VarChar(100)
  served Boolean
  amountCents Int?
  deliveryDays Int?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ranges CepRange[]
  @@index([region, id])
}

model CepRange {
  id String @id @default(uuid()) @db.Uuid
  freightRateId String @db.Uuid
  freightRate FreightRate @relation(fields: [freightRateId], references: [id], onDelete: Restrict)
  startZip String @db.Char(8)
  endZip String @db.Char(8)
  @@index([freightRateId])
  @@index([startZip, endZip])
}

enum PaymentMethod {
  PIX
  BOLETO
  CARD
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SEPARATED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ChargeStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELLED
  SUPERSEDED
}

enum OrderUnitState {
  KEPT
  CANCELLED
  RETURNED
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  checkoutId String @unique @db.Uuid
  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  status OrderStatus @default(PENDING)
  method PaymentMethod
  version Int @default(1)
  snapshot Json
  addressSnapshot Json
  freightSnapshot Json
  subtotalCents BigInt
  discountCents BigInt
  shippingCents Int
