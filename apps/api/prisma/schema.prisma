generator client {
  provider            = "prisma-client"
  output              = "../src/persistence/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum AccountContext {
  CUSTOMER
  STAFF
}

enum Role {
  USER
  ADMIN
  OPERATOR
}

enum EmailPurpose {
  VERIFY
  CHANGE
  REACTIVATE
}

enum MessageStatus {
  PENDING
  FAILED
  DELIVERED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  emailNormalized String          @unique
  passwordHash    String
  context         AccountContext
  role            Role
  emailVerifiedAt DateTime?       @db.Timestamptz(3)
  blockedAt       DateTime?       @db.Timestamptz(3)
  closedAt        DateTime?       @db.Timestamptz(3)
  inactiveAt      DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  resets          PasswordReset[]
  emailTokens     EmailToken[]
  auditLogs       AuditLog[]
  messages        DemoMessage[]
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  credentialHash   String    @unique @db.Char(64)
  refreshHash      String    @unique @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  refreshExpiresAt DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model EmailToken {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose      EmailPurpose
  pendingEmail String?
  tokenHash    String       @unique @db.Char(64)
  expiresAt    DateTime     @db.Timestamptz(3)
  usedAt       DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose, expiresAt])
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  actorId         String?  @db.Uuid
  actor           User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action          String
  targetType      String
  targetId        String
  result          String
  reason          String
  redactedChanges Json
  correlationId   String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model DomainEvent {
  id            String        @id @default(uuid()) @db.Uuid
  type          String
  aggregateId   String
  payload       Json
  processedAt   DateTime?     @db.Timestamptz(3)
  attempts      Int           @default(0)
  lastErrorCode String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  messages      DemoMessage[]

  @@index([processedAt, createdAt, id])
}

model DemoMessage {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventId        String?       @db.Uuid
  event          DomainEvent?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tokenRef       String?       @db.Uuid
  type           String
  restrictedBody String
  dedupKey       String        @unique
  status         MessageStatus @default(PENDING)
  deliveredAt    DateTime?     @db.Timestamptz(3)
  attempts       Int           @default(0)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([eventId])
  @@index([status, createdAt])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorScope  String   @db.VarChar(200)
  operation   String   @db.VarChar(100)
  key         String   @db.VarChar(128)
  requestHash String   @db.Char(64)
  resultRef   String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorScope, operation, key])
}
